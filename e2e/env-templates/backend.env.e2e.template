# ─────────────────────────────────────────────────────────────────────────────
# E2E TEST OVERRIDES (gitignored — never committed)
#
# Used only when running the Playwright suite in `e2e/` (via the `:e2e` npm
# scripts / e2e/playwright.config.ts webServer). Points the backend at a
# dedicated local Postgres database so E2E test runs never touch your regular
# dev data. Loaded on top of .env.local -> .env (dotenv -e .env.e2e.local
# -e .env.local -e .env), so everything else (Redis, CORS, ports) is inherited
# from .env.local as usual.
# ─────────────────────────────────────────────────────────────────────────────

E2E=1
DATABASE_URL="postgresql://postgres:password@localhost:5432/genxcrm_test"
# Separate Redis logical DB so BullMQ queues (round-robin assignment, etc.) never race
# with the regular dev backend's queue on DB 0 — see app.module.ts.
REDIS_DB=1

# Separate ports from the normal dev servers (3000/5173) so the E2E backend can run
# side-by-side with (or instead of) your regular `node dev.mjs` session without a port
# clash or any risk of a test hitting the wrong server.
PORT=3001
CORS_ORIGIN=http://localhost:5174
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5174

# Short SLA intervals so SLA cases can observe a breach inside a test
SLA_TICK_MS=5000
SLA_DATE_SWEEP_MS=5000

# ── E2E must never reach real third-party providers ─────────────────────────
# backend/.env is prod-shaped and is loaded AFTER this file by the dev:e2e script (first value wins),
# so blank every outbound-capable credential here. Empty string = "not configured": services degrade
# gracefully (see CLAUDE.md "leave blank in dev"). Added 2026-10-03 after an E2E probe reached the real Meta account.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_SSO_APP_SECRET=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_FORMS_CLIENT_SECRET=

# Never reach real AWS: no bucket, and a credentials file that does not exist (blocks fallback to ~/.aws)
S3_BUCKET=
AWS_SHARED_CREDENTIALS_FILE=C:/nonexistent/aws-credentials
AWS_PROFILE=e2e-none
AUTH_RATE_LIMIT_MAX=1000
