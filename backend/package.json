{
  "name": "genxcrm-backend",
  "version": "1.0.0",
  "description": "GenXCRM backend API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint 'src/**/*.ts' --fix",
    "lint:check": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --passWithNoTests --forceExit",
    "test:cov": "jest --coverage --forceExit",
    "test:e2e": "jest --config test/jest-e2e.json --forceExit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:migrate:local": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:deploy:local": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "db:seed:local": "dotenv -e .env.local -e .env -- ts-node prisma/seed.ts",
    "db:studio:local": "dotenv -e .env.local -e .env -- prisma studio",
    "backfill:mfg-defaults": "ts-node prisma/backfill-manufacturing-defaults.ts",
    "backfill:mfg-defaults:local": "dotenv -e .env.local -e .env -- ts-node prisma/backfill-manufacturing-defaults.ts",
    "seed:man-testdata": "ts-node prisma/seed-man-org-testdata.ts",
    "seed:man-testdata:local": "dotenv -e .env.local -e .env -- ts-node prisma/seed-man-org-testdata.ts",
    "migrate:subscription-plans": "ts-node prisma/migrate-subscriptions-to-new-plans.ts",
    "migrate:emandate-subscription": "ts-node prisma/migrate-emandate-subscription.ts",
    "backfill:welcome": "ts-node prisma/backfill-welcome-sequences.ts",
    "backfill:welcome:local": "dotenv -e .env.local -e .env -- ts-node prisma/backfill-welcome-sequences.ts",
    "backfill:campaigns": "ts-node prisma/backfill-campaign-ids.ts",
    "backfill:campaigns:local": "dotenv -e .env.local -e .env -- ts-node prisma/backfill-campaign-ids.ts",
    "backfill:adsets": "ts-node prisma/backfill-adset-ids.ts",
    "backfill:adsets:local": "dotenv -e .env.local -e .env -- ts-node prisma/backfill-adset-ids.ts",
    "backfill:lead-names": "ts-node prisma/backfill-lead-name-lengths.ts",
    "backfill:lead-names:local": "dotenv -e .env.local -e .env -- ts-node prisma/backfill-lead-name-lengths.ts",
    "demo:seed": "ts-node prisma/seed-demo.ts",
    "demo:seed:local": "dotenv -e .env.local -e .env -- ts-node prisma/seed-demo.ts",
    "demo:seed:leads": "ts-node prisma/seed-demo-user-leads.ts",
    "demo:seed:leads:local": "dotenv -e .env.local -e .env -- ts-node prisma/seed-demo-user-leads.ts",
    "demo:seed:client": "ts-node prisma/seed-demo-client.ts",
    "db:migrate:e2e": "dotenv -e .env.e2e.local -e .env.local -e .env -- prisma migrate deploy",
    "db:seed:e2e": "dotenv -e .env.e2e.local -e .env.local -e .env -- ts-node prisma/seed-e2e.ts",
    "db:seed:e2e:mfg": "dotenv -e .env.e2e.local -e .env.local -e .env -- ts-node prisma/seed-e2e-mfg.ts",
    "dev:e2e": "dotenv -e .env.e2e.local -e .env.local -e .env -- nest start",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@nestjs/bull": "^10.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.8.1",
    "@sendgrid/mail": "^8.1.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "aws-sdk": "^2.1549.0",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express-session": "^1.19.0",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "twilio": "^5.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.2.5",
    "prisma": "^5.8.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
