DATABASE_URL="postgresql://postgres:password@localhost:5432/genxcrm"
REDIS_URL="redis://localhost:6379"

# Nurturing engine — how often the background tick advances due enrollments (ms).
# Default 300000 (5 min). Lower it (e.g. 5000) in dev to watch sequences run quickly.
NURTURING_TICK_MS="300000"

# Lead-assignment email debounce window (ms). After a lead is assigned, the rep is
# emailed after this delay; assignments to the same rep within the window are batched
# into a single email. Default 45000 (45s).
ASSIGNMENT_NOTIFY_DELAY_MS="45000"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# The GenXCRM team's own org (owner support+admin@genxcrm.co.in). Never billed
# (BillingService.subscribe() refuses it) and every website signup lead lands here
# via AuthService.register() -> LeadsService.captureWebsiteSignupLead(). Unset in
# local dev — both features no-op without it.
# GENXCRM_INTERNAL_ORG_ID="4c7d5b68-8dcc-44cc-b407-0f79ea92daa0"

PORT=3000
# Production: FRONTEND_URL="https://app.genxcrm.co.in"
FRONTEND_URL="http://localhost:5173"
# Absolute URL of the email logomark. Defaults to ${FRONTEND_URL}/logo-mark.png.
# Mail clients can't load localhost — in production point this (or FRONTEND_URL) at a publicly hosted URL.
# EMAIL_LOGO_URL="https://app.genxcrm.co.in/logo-mark.png"
# Production: API_URL="https://api.genxcrm.co.in"  (must match the redirect-URI domain registered with providers)
API_URL="http://localhost:3000"
# Deep link scheme the Android app registers (AndroidManifest.xml intent-filter) — where the
# Google/Facebook/Twitter OAuth callback sends a mobile-app-initiated login back to the app
# instead of the web FRONTEND_URL. Must match capacitor.config.ts's appId. Default matches prod.
# APP_SCHEME="com.genxcrm.app://"
# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:5173,https://app.genxcrm.co.in"

# SSO — Google OAuth
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SSO — X (Twitter) OAuth 2.0 (PKCE)
# Create at https://developer.x.com → your app → Keys & Tokens → OAuth 2.0 Keys
# Callback URL: http://localhost:3000/api/v1/auth/twitter/callback
# Scopes requested: users.read tweet.read users.email
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Meta (Facebook) — TWO separate apps. See docs/FACEBOOK_BUSINESS_SETUP.md.
# Meta does not allow one app to do both business Lead Ads and consumer SSO login.

# App 1 — Lead Ads (business app, "Facebook Login for Business")
#   Use cases: Manage everything on your Page + Capture & manage leads with Marketing API
#   Redirect URI: <base>/api/v1/integrations/config/facebook/oauth/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CONFIG_ID=""          # Facebook Login for Business config ID — source of truth for permissions; when set, scope below is ignored.
                                # `ads_read` must be added to this config in the Meta dashboard too — see docs/META_ADS_READ_APP_REVIEW.md.
FACEBOOK_VERIFY_TOKEN=""
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""  # Separate Facebook-Login-for-Business config (WhatsApp Embedded Signup extras) — NOT the same as FACEBOOK_CONFIG_ID used for Lead Ads OAuth.
# Production: FACEBOOK_LEAD_ADS_REDIRECT_URI="https://api.genxcrm.co.in/api/v1/integrations/config/facebook/oauth/callback"
FACEBOOK_LEAD_ADS_REDIRECT_URI="http://localhost:3000/api/v1/integrations/config/facebook/oauth/callback"
# Fallback only: used for classic scope-based login when FACEBOOK_CONFIG_ID is unset (e.g. local dev).
# Keep to the minimum set the ingestion code uses; include business_management.
# ads_read is required for the facebook-insights ad-spend sync (see docs/FACEBOOK_INSIGHTS_INTEGRATION.md);
# only usable in Development Mode for FB-app admin/tester ad accounts until Advanced Access is approved
# (docs/META_ADS_READ_APP_REVIEW.md).
FACEBOOK_OAUTH_SCOPES="public_profile,pages_show_list,leads_retrieval,pages_read_engagement,pages_manage_metadata,business_management,ads_read"

# App 2 — Login / SSO (consumer app, "Authenticate with Facebook Login")
#   Permissions: email + public_profile
#   Redirect URI: <base>/api/v1/auth/facebook/callback
FACEBOOK_SSO_APP_ID=""
FACEBOOK_SSO_APP_SECRET=""

# Meta Pixel — ad conversion tracking on the marketing landing page (landing/).
# Not consumed by the backend; deploy-landing.mjs reads this value from backend/.env
# and substitutes it into landing/index.html + landing/js/main.js at deploy time,
# since landing/ has no build step of its own.
FACEBOOK_PIXEL_ID=""

# Google Ads OAuth
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/v1/integrations/config/google/oauth/callback
# Enable: Google Ads API
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REDIRECT_URI="http://localhost:3000/api/v1/integrations/config/google/oauth/callback"

# Google Forms (OAuth, drive.file scope only) — see docs/GOOGLE_FORMS_SETUP.md
# OAuth web client id / secret
# GOOGLE_FORMS_CLIENT_ID=""
# GOOGLE_FORMS_CLIENT_SECRET=""
# API key for Google Picker (restrict to the app's web origin)
# GOOGLE_PICKER_API_KEY=""
# Google Cloud project NUMBER (Picker app id)
# GOOGLE_CLOUD_PROJECT_NUMBER=""
# Optional: OAuth redirect URI (a frontend page). Default: ${FRONTEND_URL}/integrations/google-forms/callback
# GOOGLE_FORMS_REDIRECT_URI=""
# Optional: form sync interval in ms (default 120000)
# FORM_SYNC_TICK_MS=120000

# Integration token encryption — 32-byte hex key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_SECRET_KEY=""

# Razorpay — lead payment links
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay — subscription billing
# Webhook secret: set in Razorpay Dashboard → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=""

# Cashfree payment links (optional platform fallback for orgs that have not connected their own
# account under Integrations). A TEST-prefixed App ID uses the sandbox host automatically.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# Single "GenXCRM Pro" plan, 2 rows (Monthly + Annual). Create both in Razorpay Dashboard →
# Subscriptions → Plans, then paste the plan ID (e.g. "plan_ABC123") below.
# Monthly: interval=monthly, interval_count=1, amount=49900 paise (₹499/user)
# Annual:  interval=yearly,  interval_count=1, amount=598800 paise (₹5,988/user — same
#          per-seat rate as monthly, no built-in discount; discounts are coupon-driven)
# The one-time ₹5,000 setup fee is NOT part of the plan amount — it's added at subscription
# creation as a Razorpay addon (see BillingService.buildSetupFeeAddon), no separate plan needed.
RAZORPAY_PRO_MONTHLY_PLAN_ID=""
RAZORPAY_PRO_ANNUAL_PLAN_ID=""

# Twilio (SMS + Calls)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# AWS SES — transactional email (welcome, invoices, OTP)
# IAM user needs ses:SendEmail + ses:SendRawEmail on arn:aws:ses:<region>:*:identity/*
# Also, for the org "connect your own domain" flow (IntegrationsConfigService.connectEmailSesDomain):
# ses:VerifyDomainIdentity + ses:VerifyDomainDkim + ses:GetIdentityVerificationAttributes + ses:DeleteIdentity
# on Resource "*" — these legacy actions don't support resource-level ARN scoping; see docs/aws-ses-setup.md.
# Steps:
#   1. AWS Console → SES → Verified identities → Add domain → enter genxcrm.co.in
#   2. Add the 3 DKIM CNAME records + verification TXT record shown by AWS to your DNS
#   3. Add SPF:   genxcrm.co.in   TXT  "v=spf1 include:amazonses.com ~all"
#   4. Add DMARC: _dmarc.genxcrm.co.in  TXT  "v=DMARC1; p=quarantine; rua=mailto:dmarc@genxcrm.co.in"
#   5. Request production access (SES starts in sandbox — only verified addresses can receive)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
SES_FROM_EMAIL="noreply@genxcrm.co.in"   # if unset, auth emails are logged & skipped
SES_FROM_NAME="GenXCRM"                  # display name shown to recipients (default: GenXCRM)

# Auth email flows — verification & password reset
AUTH_REQUIRE_VERIFIED_EMAIL="true"       # default: block unverified logins. set "false" to allow them (e.g. local dev)
VERIFY_TOKEN_TTL_HOURS="24"              # email-verification link lifetime
RESET_TOKEN_TTL_MINUTES="60"             # password-reset link lifetime
INVITE_TOKEN_TTL_HOURS="72"              # team-invite set-password link lifetime

# SendGrid — reserved for future campaign/marketing emails (Brevo integration planned)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL=""

# WhatsApp Business API — legacy single-tenant fallback, deprecated.
# Each org now connects its own WhatsApp Business Account from Integrations > WhatsApp
# (Director role), stored encrypted per-org — see ConnectWhatsAppDto / connectWhatsApp().
# These env vars are ONLY used as a fallback for an org that hasn't connected its own WABA
# (e.g. local dev without going through the UI). Leave commented out unless you need that.
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account (WABA) id — required to create/submit message templates and poll their
# approval status. The token must hold the `whatsapp_business_management` permission. When unset,
# template creation degrades to DRAFT (nothing is sent to Meta).
# WHATSAPP_BUSINESS_ACCOUNT_ID=""

# FIREBASE_SERVICE_ACCOUNT_JSON — the full JSON key of a Firebase service account
# (Firebase Console → Project Settings → Service Accounts → Generate new private
# key), minified to one line. Required for desktop "call alert" push notifications
# to reach a rep's phone; blank in dev degrades gracefully (alerts silently skip,
# desktop falls back to showing the number).
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# S3 — call recordings (uses same AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY above)
S3_ENDPOINT=""
S3_BUCKET="genxcrm-recordings"
# TradeIndia enquiry poller. Leave off until the request format is verified against a real account.
# TRADEINDIA_POLL_ENABLED=true
# TRADEINDIA_POLL_MS=900000
