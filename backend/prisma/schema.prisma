  updatedAt      DateTime               @updatedAt

  @@index([orgId])
}

model NurturingStep {
  id             String            @id @default(uuid())
  sequenceId     String
  sequence       NurturingSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder      Int
  type           String
  subject        String?
  body           String?
  delayDays      Int               @default(0)
  // WhatsApp template fields — only used when type = 'whatsapp' and a template is selected.
  // templateName null ⇒ free-form text (24h-window only). templateParams is an ordered string[]
  // for {{1}}..{{n}}; each entry may contain {{name}}/{{course}}/… and is interpolated per lead.
  templateName   String?
  templateLang   String?
  templateParams Json?
  // Email steps only — ordered list of Attachment ids reused for every enrollment that reaches
  // this step (persists with the step, like subject/body — never consumed on send).
  attachmentIds  Json?
