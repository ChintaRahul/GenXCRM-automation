  @@index([orgId, reportedAt])
}

// ─── Channel partners / dealers (Phase 2) ───────────────────────────────────

model Dealer {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  territory   String
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  commission  Float?
  status      String
  ownerId     String?
  owner       User?        @relation("DealerOwner", fields: [ownerId], references: [id])
  isDeleted   Boolean      @default(false)
  deals       DealerDeal[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
  @@index([ownerId])
}

// A deal a dealer registers against a customer, so two dealers (or a dealer and the direct team) don't collide.
model DealerDeal {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  dealerId     String
  dealer       Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  customer     String
  product      String
  value        Float
  status       String
  registeredOn DateTime     @default(now())
  expiresOn    DateTime
  notes        String?
  createdAt    DateTime     @default(now())

  @@index([orgId])
  @@index([dealerId])
}

// ─── Tender / PSU sales (Phase 2) ───────────────────────────────────────────

model Tender {
  id                 String       @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  title              String
  tenderNo           String
  authority          String
  accountId          String?
  account            Account?     @relation(fields: [accountId], references: [id])
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id])
  estimatedValue     Float
  publishedOn        DateTime?
  submissionDeadline DateTime
  openingDate        DateTime?
  emdAmount          Float?
  emdStatus          String       @default("Not required")
  // Submission checklist.
  docsReady          Boolean      @default(false)
  technicalBidReady  Boolean      @default(false)
  financialBidReady  Boolean      @default(false)
  preBidAttended     Boolean      @default(false)
  status             String
  outcomeNote        String?
  ownerId            String?
  owner              User?        @relation("TenderOwner", fields: [ownerId], references: [id])
  isDeleted          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId])
  @@index([ownerId])
  @@index([submissionDeadline])
}

// ─── ERP / accounting connector (Phase 3) ───────────────────────────────────

// Where and how an org's ERP wants to receive customers, items, orders, dispatches and receipts.
model ErpConnection {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  endpointUrl String
  secret      String
  entities    String
  isActive    Boolean      @default(true)
  lastSyncAt  DateTime?
  lastStatus  String?
  isDeleted   Boolean      @default(false)
  logs        ErpSyncLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
}

model ErpSyncLog {
  id           String        @id @default(uuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id])
  connectionId String
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entity       String
  records      Int
  status       String
  detail       String?
  createdAt    DateTime      @default(now())

  @@index([connectionId])
  @@index([orgId])
}

// ─── Engagement for Manufacturing records ───────────────────────────────────

// Enrols a Manufacturing record (lead, quotation, opportunity, AMC coverage) into a nurturing sequence.
model MfgNurtureEnrollment {
  id          String            @id @default(uuid())
  orgId       String
  org         Organization      @relation(fields: [orgId], references: [id])
  sequenceId  String
  sequence    NurturingSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  status      String            @default("active")
  currentStep Int               @default(0)
  nextRunAt   DateTime?
  enrolledAt  DateTime          @default(now())
  completedAt DateTime?

  @@unique([sequenceId, entityType, entityId])
  @@index([status, nextRunAt])
  @@index([orgId])
}
