generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum TeamType {
  MEMBER
  MANAGER
}

enum Role {
  DIRECTOR
  MANAGER
  SALES_REP
}

enum VerificationTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
  MFA_RESET
}

enum LeadSource {
  FACEBOOK
  GOOGLE_ADS
  WEBSITE
  INSTAGRAM
  WALK_IN
  REFERRAL
  OUTBOUND_CALL
  CHAT
  API
  OTHER
}

enum CourseCategory {
  TEST_PREP
  LANGUAGE
  TEST_SERIES
  PROFESSIONAL_SKILLS
  OTHER
}

enum CourseSource {
  MANUAL
  LEAD
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  RINGING_NOT_REACHABLE
  FOLLOW_UP_REQUIRED
  CALL_BACK
  CALL_NOT_RECEIVED
  SWITCHED_OFF
  WHATSAPP_SENT
  DEMO_SCHEDULED
  DEMO_ATTENDED
  NEGOTIATION
  ENROLLMENT_PENDING
  ENROLLED
  NOT_INTERESTED
  DROPPED
  CLOSED_WON
  CLOSED_LOST
}

enum CallOutcome {
  CONNECTED
  NOT_CONNECTED
}

enum CallRecordingStatus {
  PENDING
  UPLOADED
  FAILED
}

enum AttachmentStatus {
  PENDING
  UPLOADED
  FAILED
}

enum CommType {
  EMAIL
  SMS
  WHATSAPP
  CALL
  NOTE
  DEMO
}

enum PaymentStatus {
  PENDING
  LINK_SENT
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  PAYU
  CASHFREE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum GstType {
  CGST_SGST
  IGST
}

enum DiscountType {
  PERCENT
  FLAT
}

enum RegistrationPaymentMode {
  SAVE
  SCREENSHOT
}

enum EmiPaymentMode {
  MANUAL
  SUBSCRIPTION
}

enum EmiMandateStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  HALTED
  CANCELLED
  COMPLETED
}

enum EmiInstallmentStatus {
  PENDING
  PAID
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
}

enum WorkspaceType {
  EDTECH
  MANUFACTURING
}

enum MfgRole {
  SUPER_ADMIN
  DIRECTOR
  SALES_HEAD
  SALES_MANAGER
  SALES_EXECUTIVE
  APPLICATION_ENGINEER
  COMMERCIAL_ESTIMATION
  OPERATIONS
  ACCOUNTS
  SERVICE_MANAGER
  SERVICE_ENGINEER
}

enum Industry {
  EDTECH
  REAL_ESTATE
  HEALTHCARE
  FINANCIAL_SERVICES
  ECOMMERCE
  SAAS_TECHNOLOGY
  CONSULTING
  MANUFACTURING
  HOSPITALITY
  OTHER
}

enum OrgSize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum PlanStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum IntegrationProvider {
  FACEBOOK
  GOOGLE_ADS
  WEBHOOK
  WHATSAPP
  EMAIL
  RAZORPAY
  GOOGLE_FORMS
  CASHFREE
  TRADEINDIA
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum AddonType {
  EMAIL_CREDITS
  WHATSAPP_CREDITS
}

enum AddonStatus {
  PENDING
  PAID
}

enum CouponRedemptionStatus {
  PENDING
  APPLIED
  FAILED
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                          String                       @id @default(uuid())
  googleForms                 GoogleForm[]
  savedViews                  SavedView[]
  moduleColumnPrefs           ModuleColumnPref[]
  moduleAuditEntries          ModuleAuditEntry[]
  moduleDocuments             ModuleDocument[]
  ingestionFailures           IngestionFailure[]
  name                        String
  slug                        String                       @unique
  industry                    Industry
  workspaceType               WorkspaceType                @default(EDTECH)
  size                        OrgSize
  website                     String?
  phone                       String?
  email                       String?
  city                        String?
  state                       String?
  country                     String
  timezone                    String
  // S3 object key, never a raw URL (CLAUDE.md rule 6) — resolved to a signed URL on
  // read, or fetched server-side as bytes when embedding into a generated PDF.
  logoKey                     String?
  primaryColor                String?
  domain                      String?
  gstNumber                   String?
  planStatus                  PlanStatus                   @default(TRIAL)
  trialEndsAt                 DateTime
  notifyRepOnAssignment       Boolean                      @default(true)
  emailsSentThisCycle         Int                          @default(0)
  emailCycleStartedAt         DateTime                     @default(now())
  // One-time free WhatsApp credit consumed via the shared API (never resets).
  whatsappCreditsUsed         Int                          @default(0)
  // Set at signup (register() or completeProfile()) — see common/constants/terms.constants.ts.
  termsAcceptedAt             DateTime?
  termsVersion                String?
  orgWebhookToken             String?                      @unique
  securitySettings            Json?
  notificationSettings        Json?
  // 'YYYY-MM-DD' (org timezone) of the last daily follow-up digest, so it goes out once a day.
  followUpDigestSentOn        String?
  routingSettings             Json?
  paymentSettings             Json?
  coreFieldAliases            Json?
  customFieldDefs             Json?
  fieldOrder                  Json?
  detectedFormFields          Json?
  apiKey                      String?                      @unique
  ownerId                     String                       @unique
  owner                       User                         @relation("OrgOwner", fields: [ownerId], references: [id])
  users                       User[]                       @relation("OrgMembers")
  leads                       Lead[]
  teams                       Team[]
  sequences                   NurturingSequence[]
  stageConfigs                StageConfig[]
  messageTemplates            MessageTemplate[]
  integrations                OrgIntegration[]
  subscription                OrgSubscription?
  campaigns                   Campaign[]
  adSets                      AdSet[]
  ads                         Ad[]
  invoices                    Invoice[]
  courses                     Course[]
  tutors                      Tutor[]
  couponRedemptions           CouponRedemption[]
  attachments                 Attachment[]
  whatsappGlobalConversations WhatsAppGlobalConversation[]
  accounts                    Account[]
  contacts                    Contact[]
  mfgLeads                    MfgLead[]
  opportunities               Opportunity[]
  mfgActivities               MfgActivity[]
  rfqs                        Rfq[]
  siteVisits                  SiteVisit[]
  evaluations                 Evaluation[]
  products                    Product[]
  costingSheets               CostingSheet[]
  quotations                  Quotation[]
  approvals                   Approval[]
  purchaseOrders              PurchaseOrder[]
  salesOrders                 SalesOrder[]
  dispatches                  Dispatch[]
  paymentMilestones           PaymentMilestone[]
  installedAssets             InstalledAsset[]
  coverages                   Coverage[]
  serviceTickets              ServiceTicket[]
  masterValues                MasterValue[]
  approvalRules               ApprovalRule[]
  slaPolicies                 SlaPolicy[]
  slaTimers                   SlaTimer[]
  businessCalendars           BusinessCalendar[]
  holidays                    Holiday[]
  dealers                     Dealer[]
  dealerDeals                 DealerDeal[]
  tenders                     Tender[]
  erpConnections              ErpConnection[]
  erpSyncLogs                 ErpSyncLog[]
  mfgEnrollments              MfgNurtureEnrollment[]
  automationRules             AutomationRule[]
  rolePermissions             RolePermission[]
  fieldPermissions            FieldPermission[]
  documentTemplates           DocumentTemplate[]
  reports                     Report[]
  notifications               Notification[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

// ─── User & Team ─────────────────────────────────────────────────────────────

model Team {
  id            String        @id @default(uuid())
  name          String
  type          TeamType      @default(MEMBER)
  managerId     String?
  manager       User?         @relation("TeamManager", fields: [managerId], references: [id])
  members       User[]        @relation("TeamMembers")
  leads         Lead[]
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id])
  monthlyTarget Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([orgId])
}

model OAuthAccount {
  id         String   @id @default(uuid())
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model User {
  id                         String                    @id @default(uuid())
  name                       String
  email                      String                    @unique
  phone                      String?
  passwordHash               String?
  role                       Role                      @default(SALES_REP)
  mfgRole                    MfgRole?
  isActive                   Boolean                   @default(true)
  emailVerified              Boolean                   @default(false)
  emailVerifiedAt            DateTime?
  mustChangePassword         Boolean                   @default(false)
  passwordChangedAt          DateTime?
  mfaSecret                  String?
  mfaEnabledAt               DateTime?
  lastAssignedAt             DateTime?
  pushToken                  String?
  pushTokenUpdatedAt         DateTime?
  teamId                     String?
  team                       Team?                     @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeams               Team[]                    @relation("TeamManager")
  assignedLeads              Lead[]                    @relation("AssignedLeads")
  activities                 Activity[]
  calls                      Communication[]
  callRecordings             CallRecording[]
  auditLogs                  AuditLog[]
  savedViews                 SavedView[]
  moduleColumnPrefs          ModuleColumnPref[]
  moduleAuditEntries         ModuleAuditEntry[]
  moduleDocuments            ModuleDocument[]
  oauthAccounts              OAuthAccount[]
  importMappings             ImportMapping[]
  messageTemplates           MessageTemplate[]
  verificationTokens         VerificationToken[]
  recoveryCodes              MfaRecoveryCode[]
  attachmentsUploaded        Attachment[]
  orgId                      String?
  org                        Organization?             @relation("OrgMembers", fields: [orgId], references: [id])
  ownedOrg                   Organization?             @relation("OrgOwner")
  invoicesRegistered         Invoice[]                 @relation("InvoiceRegisteredBy")
  invoicesCreated            Invoice[]                 @relation("InvoiceCreatedBy")
  ownedAccounts              Account[]                 @relation("AccountOwner")
  ownedMfgLeads              MfgLead[]                 @relation("MfgLeadOwner")
  ownedOpportunities         Opportunity[]             @relation("OpportunityOwner")
  technicalOpportunities     Opportunity[]             @relation("OpportunityTechOwner")
  ownedMfgActivities         MfgActivity[]             @relation("MfgActivityOwner")
  opportunityStageChanges    OpportunityStageHistory[]
  ownedRfqs                  Rfq[]                     @relation("RfqOwner")
  rfqRevisionsCreated        RfqRevision[]
  ownedSiteVisits            SiteVisit[]               @relation("SiteVisitOwner")
  ownedEvaluations           Evaluation[]              @relation("EvaluationOwner")
  preparedCostingSheets      CostingSheet[]            @relation("CostingSheetOwner")
  approvedCostingSheets      CostingSheet[]            @relation("CostingSheetApprover")
  ownedQuotations            Quotation[]               @relation("QuotationOwner")
  approvalsRequested         Approval[]                @relation("ApprovalRequestedBy")
  ownedPurchaseOrders        PurchaseOrder[]           @relation("PurchaseOrderOwner")
  ownedSalesOrders           SalesOrder[]              @relation("SalesOrderOwner")
  orderMilestonesCreated     OrderMilestone[]
  ownedPaymentMilestones     PaymentMilestone[]        @relation("PaymentMilestoneOwner")
  acctOwnedPaymentMilestones PaymentMilestone[]        @relation("PaymentMilestoneAccountsOwner")
  receiptsCreated            Receipt[]
  ownedCoverages             Coverage[]                @relation("CoverageOwner")
  ownedDealers               Dealer[]                  @relation("DealerOwner")
  ownedTenders               Tender[]                  @relation("TenderOwner")
  assignedServiceTickets     ServiceTicket[]           @relation("ServiceTicketEngineer")
  ownedReports               Report[]                  @relation("ReportOwner")
  notifications              Notification[]
  monthlyTarget              Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique // SHA-256 of the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

// ─── Lead ────────────────────────────────────────────────────────────────────

model Lead {
  id                          String                       @id @default(uuid())
  name                        String
  email                       String?
  altEmail                    String?
  phone                       String
  altPhone                    String?
  course                      String?
  location                    String?
  language                    String?
  source                      LeadSource                   @default(OTHER)
  sourceCampaign              String?
  sourceAdSet                 String?
  sourceAd                    String?
  campaignId                  String?
  campaign                    Campaign?                    @relation(fields: [campaignId], references: [id])
  adSetId                     String?
  adSet                       AdSet?                       @relation(fields: [adSetId], references: [id])
  adId                        String?
  ad                          Ad?                          @relation(fields: [adId], references: [id])
  stage                       LeadStage                    @default(NEW)
  score                       Int                          @default(0)
  interestedCount             Int                          @default(0)
  isDeleted                   Boolean                      @default(false)
  notInterestedAt             DateTime?
  notInterestedReason         String?
  customFields                Json?
  leadgenId                   String?
  rawFields                   Json?
  tags                        String[]
  assignedToId                String?
  assignedTo                  User?                        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  teamId                      String?
  team                        Team?                        @relation(fields: [teamId], references: [id])
  orgId                       String?
  org                         Organization?                @relation(fields: [orgId], references: [id])
  activities                  Activity[]
  communications              Communication[]
  payments                    Payment[]
  callRecordings              CallRecording[]
  enrollments                 NurturingEnrollment[]
  formSubmissions             FormSubmission[]
  invoices                    Invoice[]
  whatsappGlobalConversations WhatsAppGlobalConversation[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  // Explicitly touched only on genuine resubmission (same person re-enquiring) — unlike
  // `updatedAt`, this is NOT auto-bumped by every edit (stage change, reassignment, notes).
  // Powers "resurface as new" in the notification bell and the leads list's default sort,
  // so routine edits no longer masquerade as new lead activity.
  activityAt                  DateTime                     @default(now())
  // When the rep plans to follow up next (+ what to do). Drives the dashboard's follow-up
  // actions list and the daily follow-up reminder. Cleared when the follow-up is done.
  followUpAt                  DateTime?
  followUpNote                String?
  // Set when the lead sits in an org-defined custom stage; `stage` then holds that stage's
  // `countsAs` enum value so reports/filters keep working. Null for built-in stages.
  customStageId               String?
  customStage                 StageConfig?                 @relation(fields: [customStageId], references: [id], onDelete: SetNull)

  @@index([customStageId])
  @@index([phone])
  @@index([followUpAt])
  @@index([email])
  @@index([stage])
  @@index([assignedToId])
  @@index([teamId])
  @@index([orgId])
  @@index([source])
  @@index([campaignId])
  @@index([adSetId])
  @@index([adId])
  @@index([activityAt])
  @@index([leadgenId])
}

// ─── Lead Stage Config ───────────────────────────────────────────────────────
// Per-org stage customisation. baseStage set = override of a built-in LeadStage
// (label/colour/order/hidden); baseStage null = custom stage, which counts as `countsAs`.

model StageConfig {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label     String
  color     String
  sortOrder Int
  isHidden  Boolean      @default(false)
  baseStage LeadStage?
  countsAs  LeadStage?
  leads     Lead[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, baseStage])
  @@index([orgId])
}

// ─── Activity / Timeline ─────────────────────────────────────────────────────

model Activity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─── Communication ───────────────────────────────────────────────────────────

model Communication {
  id            String         @id @default(uuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id])
  type          CommType
  direction     String         @default("outbound")
  subject       String?
  body          String?
  status        String         @default("sent")
  externalId    String?
  sentAt        DateTime       @default(now())
  openedAt      DateTime?
  clickedAt     DateTime?
  metadata      Json?
  // Ordered list of Attachment ids sent with this email — null/empty when there were none.
  attachmentIds Json?
  // Call-specific fields — set only when type = CALL, via logCall(). Historical
  // rows (duration previously stashed in metadata.durationSec) stay null.
  callOutcome   CallOutcome?
  durationSec   Int?
  calledById    String?
  calledBy      User?          @relation(fields: [calledById], references: [id])
  callRecording CallRecording?

  @@index([leadId])
  @@index([type])
  @@index([calledById])
}

// ─── Call Recording ──────────────────────────────────────────────────────────
// No direct orgId field — mirrors Communication's convention (leadId-only).
// Scope queries through the lead relation: `{ lead: { orgId: caller.orgId } }`.

model CallRecording {
  id              String              @id @default(uuid())
  leadId          String
  lead            Lead                @relation(fields: [leadId], references: [id])
  uploadedById    String?
  uploadedBy      User?               @relation(fields: [uploadedById], references: [id])
  s3Key           String              @unique
  mimeType        String?
  fileSize        Int?
  durationSec     Int?
  transcriptKey   String?
  status          CallRecordingStatus @default(PENDING)
  recordedAt      DateTime            @default(now())
  uploadedAt      DateTime?
  communicationId String?             @unique
  communication   Communication?      @relation(fields: [communicationId], references: [id])

  @@index([leadId])
  @@index([uploadedById])
}

// ─── Attachment ──────────────────────────────────────────────────────────────
// Reused across sends — a lead email attaches by id, and a NurturingStep's attachmentIds
// reference the same rows for every enrollment that reaches that step. Never deleted on send.

model Attachment {
  id           String           @id @default(uuid())
  orgId        String?
  org          Organization?    @relation(fields: [orgId], references: [id])
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id])
  fileName     String
  mimeType     String
  fileSize     Int
  s3Key        String           @unique
  status       AttachmentStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  @@index([orgId])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id               String         @id @default(uuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id])
  gateway          PaymentGateway
  amount           Float
  currency         String         @default("INR")
  status           PaymentStatus  @default(PENDING)
  paymentLink      String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  installments     Installment[]
  gstPercent       Float          @default(18)
  discountAmount   Float          @default(0)
  includeGstNumber Boolean        @default(true)
  invoiceNumber    String?
  invoiceSentAt    DateTime?
  paidAt           DateTime?
  dueDate          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([leadId])
}

model Installment {
  id        String        @id @default(uuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id])
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?
  status    PaymentStatus @default(PENDING)
}

// ─── Course ──────────────────────────────────────────────────────────────────

model Course {
  id           String         @id @default(uuid())
  orgId        String
  org          Organization   @relation(fields: [orgId], references: [id])
  name         String
  category     CourseCategory @default(OTHER)
  defaultPrice Float
  isActive     Boolean        @default(true)
  source       CourseSource   @default(MANUAL)
  leadName     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  invoiceLineItems InvoiceLineItem[]
  batches          Batch[]

  @@index([orgId])
}

model Tutor {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  batches Batch[]

  @@index([orgId])
}

model Batch {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label     String
  schedule  String
  tutorId   String?
  tutor     Tutor?   @relation(fields: [tutorId], references: [id])
  capacity  Int      @default(0)
  seats     Int      @default(0)
  // Soft-delete only, mirroring the Lead/Invoice pattern (CLAUDE.md rule 5) — a batch can be
  // referenced by existing InvoiceLineItem rows (registration/course history), so removing it
  // from the Courses UI must not erase that history.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLineItems InvoiceLineItem[]

  @@index([courseId])
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id])
  isDeleted Boolean      @default(false)

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?

  notes String?

  gstEnabled    Boolean      @default(true)
  gstType       GstType      @default(CGST_SGST)
  gstRate       Float        @default(18)
  discountType  DiscountType @default(FLAT)
  discountValue Float        @default(0)

  subtotal       Float  @default(0)
  discountAmount Float  @default(0)
  taxableAmount  Float  @default(0)
  taxAmount      Float  @default(0)
  cgstAmount     Float?
  sgstAmount     Float?
  igstAmount     Float?
  grandTotal     Float  @default(0)

  paymentLinkAttached Boolean         @default(false)
  paymentGateway      PaymentGateway?
  paymentLinkUrl      String?
  sentAt              DateTime?
  paidAt              DateTime?

  registeredAt              DateTime?
  registeredById            String?
  registeredBy              User?                    @relation("InvoiceRegisteredBy", fields: [registeredById], references: [id])
  registrationFee           Float?
  registrationPaymentMode   RegistrationPaymentMode?
  registrationScreenshotKey String?
  registrationNote          String?
  // Set when a sent registration-fee payment link is confirmed paid — via the Razorpay
  // webhook (automatic) or the "Mark as paid" manual override. Independent of
  // registrationFee/registrationPaymentMode/registeredAt, which stay owned by the
  // explicit "Save registration" action and can be set before this ever is.
  registrationFeePaidAt     DateTime?
  // EMI auto-debit mandate (Razorpay Subscriptions) — emiPaymentMode is set once when the
  // EMI plan is first created (createEmiPlan or createEmiMandate) and never changes
  // afterward; the other three fields stay null for MANUAL invoices.
  emiPaymentMode            EmiPaymentMode           @default(MANUAL)
  emiGatewaySubscriptionId  String?
  emiMandateStatus          EmiMandateStatus?
  emiMandateShortUrl        String?
  generatedFromRegistration Boolean                  @default(false)

  lineItems       InvoiceLineItem[]
  emiInstallments EmiInstallment[]

  createdById String?
  createdBy   User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([leadId])
  @@index([status])
}

model InvoiceLineItem {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id])
  courseName String
  batchId    String?
  batch      Batch?  @relation(fields: [batchId], references: [id])
  batchLabel String?
  quantity   Int     @default(1)
  unitPrice  Float
  lineTotal  Float
  sortOrder  Int     @default(0)

  @@index([invoiceId])
}

model EmiInstallment {
  id                  String               @id @default(uuid())
  invoiceId           String
  invoice             Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNumber   Int
