  @@index([leadId])
  @@index([status, nextRunAt])
}

// ─── Email Templates ──────────────────────────────────────────────────────────

enum TemplateChannel {
  EMAIL
  WHATSAPP
}

// WhatsApp message-template approval lifecycle (Meta). EMAIL templates leave status null.
// DRAFT = saved locally but not submitted (e.g. WABA not configured / submit failed).
enum WhatsappTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model MessageTemplate {
  id               String                  @id @default(uuid())
  channel          TemplateChannel         @default(EMAIL)
  name             String
  subject          String? // email only; null for WhatsApp
  body             String
  isSystem         Boolean                 @default(false) // global read-only defaults (orgId null)
  orgId            String?
  org              Organization?           @relation(fields: [orgId], references: [id])
  createdById      String?
  createdBy        User?                   @relation(fields: [createdById], references: [id])
  // WhatsApp-only: Meta approval tracking. All null for EMAIL templates.
  status           WhatsappTemplateStatus?
  language         String? // e.g. "en_US"
  category         String? // MARKETING | UTILITY | AUTHENTICATION
  metaTemplateName String? // lowercase snake_case name registered with Meta (unique across the WABA)
  metaTemplateId   String? // id returned by Meta on submit
  rejectionReason  String? // populated when REJECTED, or a DRAFT note (e.g. WABA not configured)
  variables        Json? // ordered named-var list e.g. ["name","course"] mapping to {{1}}..{{n}}
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([orgId])
  @@map("message_templates")
}

// ─── Import Mapping Templates ─────────────────────────────────────────────────

model ImportMapping {
  id          String   @id @default(uuid())
  name        String
  mappings    Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

// ─── Org Integration (per-org OAuth credentials + webhook config) ─────────────

model OrgIntegration {
  id                   String              @id @default(cuid())
  orgId                String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(DISCONNECTED)
  accessToken          String?
  refreshToken         String?
  tokenExpiry          DateTime?
  accountId            String?
  accountName          String?
  webhookSecret        String?
  metadata             Json?
  // Facebook Marketing API ad account — distinct from the Page (accountId/accessToken above).
  adAccountId          String?
  adAccountName        String?
  adAccountAccessToken String?
  lastSyncedAt         DateTime?
  // Set when status leaves CONNECTED (manual disconnect or a sync/webhook detecting an
  // invalid token). Cleared on reconnect, after which its old value seeds the backfill
  // window for leads generated while the integration was down. See facebook-lead-backfill module.
  disconnectedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([accountId])
  @@index([adAccountId])
}

// Only relevant for orgs with no connected WABA, sending via the shared
// WHATSAPP_PHONE_NUMBER_ID fallback (see CommunicationsService.resolveWhatsAppCredentials,
// isOwnIntegration: false). Records which org/lead we last messaged a given phone number on
// behalf of, so an inbound reply to the shared number — which carries no org signal from
// Meta, only the customer's phone — can be routed to the right lead. Upserted on every
// successful global-fallback send; read on inbound webhook events for the shared WABA (see
// WhatsappWebhookService). On the rare case where two different orgs' leads share the same
// phone number, the most recent sender wins — an inherent limit of one shared number serving
// many tenants, not something more code can fully resolve.
model WhatsAppGlobalConversation {
  id         String       @id @default(cuid())
  phone      String       @unique
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id])
  lastSentAt DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orgId])
  @@index([leadId])
}

// ─── Subscription / Billing ───────────────────────────────────────────────────

model SubscriptionPlan {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  tier            String
  pricePerUser    Float
  // One-time fee (INR) charged as a Razorpay subscription addon on the first invoice only.
  setupFee        Float             @default(0)
  billingInterval BillingInterval   @default(MONTHLY)
  razorpayPlanId  String?
  minUsers        Int               @default(1)
  maxUsers        Int?
  features        Json
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  subscriptions   OrgSubscription[]

  @@index([tier])
  @@index([billingInterval])
}

model OrgSubscription {
  id                 String              @id @default(uuid())
  orgId              String              @unique
  org                Organization        @relation(fields: [orgId], references: [id])
  planId             String
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id])
  status             SubscriptionStatus  @default(CREATED)
  razorpaySubId      String?             @unique
  razorpayCustomerId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean             @default(false)
  cancelledAt        DateTime?
  userCount          Int                 @default(1)
  addons             SubscriptionAddon[]
  events             BillingEvent[]
  couponRedemptions  CouponRedemption[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
}

// A coupon discounts only the FIRST charge of a new subscription. By default the
// discount is settled out-of-band as a refund once the first `subscription.charged`
// webhook lands (see BillingService.onCharged) — Razorpay's recurring Subscriptions
// API bills the plan's fixed price every cycle with no per-subscription discount hook,
// so the subscription is created at full price and the refund happens after.
//
// When razorpayOfferIds has an entry for the chosen (billingInterval, paymentMethod)
// pair, BillingService instead passes that Razorpay Offer's id as `offer_id` on
// subscription creation, so Razorpay discounts the charge itself, before payment —
// see docs/razorpay-billing-setup.md. A Razorpay Offer is scoped to exactly one Plan
// and one payment method (Card XOR UPI, not both), which is why this is keyed by both.
// Shape: { "MONTHLY": { "card": "offer_...", "upi": "offer_..." }, "ANNUAL": { ... } }.
// Any combination without an entry falls back to the refund path above.
model Coupon {
  id                  String             @id @default(uuid())
  code                String             @unique
  discountType        DiscountType       @default(PERCENT)
  discountValue       Float
  // Plan tiers (SubscriptionPlan.tier) this coupon applies to. Empty = all tiers.
  applicablePlanTiers String[]           @default([])
  maxRedemptions      Int?
  redemptionCount     Int                @default(0)
  expiresAt           DateTime?
  isActive            Boolean            @default(true)
  razorpayOfferIds    Json?
  redemptions         CouponRedemption[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([code])
}

model CouponRedemption {
  id               String                 @id @default(uuid())
  couponId         String
  coupon           Coupon                 @relation(fields: [couponId], references: [id])
  orgId            String
  org              Organization           @relation(fields: [orgId], references: [id])
  subscriptionId   String
  subscription     OrgSubscription        @relation(fields: [subscriptionId], references: [id])
  // Snapshot of the coupon's terms at redemption time, so a later edit to the
  // Coupon row can't change what a customer already redeemed.
  discountType     DiscountType
  discountValue    Float
  status           CouponRedemptionStatus @default(PENDING)
  razorpayRefundId String?
  appliedAt        DateTime?
  createdAt        DateTime               @default(now())

  @@unique([couponId, orgId])
  @@index([subscriptionId])
  @@index([status])
}

model SubscriptionAddon {
  id                    String          @id @default(uuid())
  subscriptionId        String
  subscription          OrgSubscription @relation(fields: [subscriptionId], references: [id])
  type                  AddonType
  quantity              Int
  usedCount             Int             @default(0)
  pricePaid             Float
  status                AddonStatus     @default(PENDING)
  razorpayPaymentId     String?
  razorpayPaymentLinkId String?         @unique
  validUntil            DateTime?
  createdAt             DateTime        @default(now())

  @@index([subscriptionId])
}

model BillingEvent {
  id                String          @id @default(uuid())
  subscriptionId    String
  subscription      OrgSubscription @relation(fields: [subscriptionId], references: [id])
  event             String
  amount            Float?
  currency          String          @default("INR")
  razorpayPaymentId String?
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([subscriptionId])
}

// ─── Google Forms ────────────────────────────────────────────────────────────

enum FormSubmissionStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model GoogleForm {
  id               String           @id @default(uuid())
  orgId            String
  org              Organization     @relation(fields: [orgId], references: [id])
  name             String
  // Google's responderUri (the public "viewform" link); prefilled links are built from it.
  formUrl          String
  // Digits of Google's `entry.NNN` id for the "Lead ID" question — only used to build prefilled links.
  leadIdEntryId    String
  // Google's own form id. Null for legacy (Apps Script) rows.
  googleFormId     String?
  responderUri     String?
  // Forms API questionId of the "Lead ID" question.
  leadIdQuestionId String?
  // Ordered [{ id, title }] for the form's questions. An array, not a map: hex question ids can look
  // like integers and JavaScript would reorder integer-like object keys.
  questionTitles   Json?
  sheetId          String?
  sheetTab         String?
  // Sync cursor: lastSubmittedTime of the newest response stored so far.
  lastResponseAt   DateTime?
  lastSyncedAt     DateTime?
  syncError        String?
  isActive         Boolean          @default(true)
  lastSubmissionAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submissions      FormSubmission[]

  @@unique([orgId, googleFormId])
  @@index([orgId])
}

model FormSubmission {
  id                 String               @id @default(uuid())
  orgId              String
  formId             String
  form               GoogleForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               Lead?                @relation(fields: [leadId], references: [id])
  // Google's response id — makes retries and resyncs idempotent.
  externalResponseId String
  answers            Json
  rawPayload         Json
  status             FormSubmissionStatus @default(RECEIVED)
  error              String?
  sheetSyncedAt      DateTime?
  sheetError         String?
  submittedAt        DateTime
  createdAt          DateTime             @default(now())

  @@unique([formId, externalResponseId])
  @@index([formId, status])
  @@index([orgId, submittedAt])
  @@index([leadId])
}

