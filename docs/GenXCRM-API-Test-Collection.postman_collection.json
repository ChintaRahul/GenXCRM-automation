    {
      "name": "TC-SEC-004 / TC-E2E-008  No cost fields in API",
      "description": "Log in as Sales Executive. Fails if any cost / margin / minimum-price key appears.",
      "item": [
        {
          "name": "Products list has no cost fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bad = ['cost','minPrice','stdCost','standardCost','margin','gm','gmPct'];",
                  "const keys = new Set((pm.response.json().data || []).flatMap(r => Object.keys(r)));",
                  "pm.test('no restricted keys: ' + bad.filter(k => keys.has(k)).join(','), () => bad.forEach(k => pm.expect(keys.has(k), k).to.be.false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/products?limit=50",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "products?limit=50"
              ]
            }
          }
        },
