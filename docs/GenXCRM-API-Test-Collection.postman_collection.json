{
  "info": {
    "name": "GenXCRM Manufacturing - API test cases",
    "description": "Runs the API-only steps of the manual test sheet. Set collection variables base, email, password then run folder 0 first, then any other folder (or Run collection). Every request carries Postman tests, so the Test Results tab shows Pass/Fail. Requests marked [WRITES DATA] change records - use throwaway data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "https://api.genxcrm.co.in/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "opp",
      "value": ""
    },
    {
      "key": "receivedMilestone",
      "value": ""
    },
    {
      "key": "renewedCoverage",
      "value": ""
    },
    {
      "key": "openTicket",
      "value": ""
    },
    {
      "key": "orgToken",
      "value": "",
      "description": "Org webhook token from Administration > Integrations > Webhook (the part in the ingest URL)."
    },
    {
      "key": "webhookSecret",
      "value": "",
      "description": "Signing secret of that webhook. Leave empty only if none is configured."
    },
    {
      "key": "otherOrgToken",
      "value": "",
      "description": "Bearer token of a user in a DIFFERENT org (log in there and paste the token)."
    },
    {
      "key": "otherOrgOppId",
      "value": "",
      "description": "An opportunity id that belongs to the different org."
    }
  ],
  "item": [
    {
      "name": "0. Setup (run first)",
      "description": "Log in as the role the test case names (change email/password for each role) and pick records to test against. Needs: an opportunity, a Received payment milestone, a Renewed coverage and an Open service ticket in the org.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token || j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            }
          }
        },
        {
          "name": "Pick an open opportunity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = (pm.response.json().data || []);",
                  "const hit = rows.find(o => !['Won','Lost'].includes(o.stage));",
                  "pm.test('found a record for opp', () => pm.expect(hit, 'No matching record in this org - see the folder description').to.exist);",
                  "if (hit) pm.collectionVariables.set('opp', hit.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/opps?limit=100",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "opps?limit=100"
              ]
            }
          }
        },
        {
          "name": "Pick a Received payment milestone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = (pm.response.json().data || []);",
                  "const hit = rows.find(m => m.status === 'Received');",
                  "pm.test('found a record for receivedMilestone', () => pm.expect(hit, 'No matching record in this org - see the folder description').to.exist);",
                  "if (hit) pm.collectionVariables.set('receivedMilestone', hit.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/payments?limit=200",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "payments?limit=200"
              ]
            },
            "description": "Log in as Accounts (or Super Admin)."
          }
        },
        {
          "name": "Pick a Renewed coverage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = (pm.response.json().data || []);",
                  "const hit = rows.find(c => c.status === 'Renewed');",
                  "pm.test('found a record for renewedCoverage', () => pm.expect(hit, 'No matching record in this org - see the folder description').to.exist);",
                  "if (hit) pm.collectionVariables.set('renewedCoverage', hit.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/amc?limit=100",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "amc?limit=100"
              ]
            },
            "description": "Log in as Service Manager (or Super Admin)."
          }
        },
        {
          "name": "Pick an Open service ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = (pm.response.json().data || []);",
                  "const hit = rows.find(t => t.status === 'Open');",
                  "pm.test('found a record for openTicket', () => pm.expect(hit, 'No matching record in this org - see the folder description').to.exist);",
                  "if (hit) pm.collectionVariables.set('openTicket', hit.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/service?limit=100",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "service?limit=100"
              ]
            },
            "description": "Log in as Service Manager (or Super Admin)."
          }
        }
      ]
    },
    {
      "name": "TC-OPP-006  Won/Lost only via actions",
      "description": "Log in as Sales Executive.",
      "item": [
        {
          "name": "5. PATCH stage = Won",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('message mentions: Use the \\'Mark won\\'/\\'Mark lost\\' actions', () => pm.expect(pm.response.text()).to.include(\"Use the 'Mark won'/'Mark lost' actions\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/opps/{{opp}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "opps",
                "{{opp}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"Won\"\n}"
            }
          }
        },
        {
          "name": "6. PATCH stage = Lost",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('message mentions: Use the \\'Mark won\\'/\\'Mark lost\\' actions', () => pm.expect(pm.response.text()).to.include(\"Use the 'Mark won'/'Mark lost' actions\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/opps/{{opp}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "opps",
                "{{opp}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"Lost\"\n}"
            }
          }
        },
        {
          "name": "7. GET opportunity - stage unchanged",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('stage is not Won/Lost', () => pm.expect(['Won','Lost']).to.not.include(pm.response.json().stage));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/opps/{{opp}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "opps",
                "{{opp}}"
              ]
            }
          }
        }
      ]
    },
