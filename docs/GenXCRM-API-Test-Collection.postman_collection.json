    {
      "name": "TC-SEC-001 / TC-SEC-002  Cross-tenant",
      "description": "Set otherOrgToken (a user of a different org) and otherOrgOppId (a record of that org). Run as the main org (token from folder 0).",
      "item": [
        {
          "name": "SEC-001 read other org record -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/modules/opps/{{otherOrgOppId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "modules",
                "opps",
                "{{otherOrgOppId}}"
              ]
            }
          }
        },
        {
          "name": "SEC-001 list never contains it",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = (pm.response.json().data || []).map(o => o.id);",
                  "pm.test('other-org id absent', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('otherOrgOppId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
