{
  "info": {
    "name": "GenXCRM API",
    "description": "Complete API collection for GenXCRM — EdTech CRM system. Base URL: {{baseUrl}}. Run Auth › Login first to populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "orgToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Director\",\n  \"email\": \"director@example.com\",\n  \"password\": \"Password123!\",\n  \"orgName\": \"Acme EdTech\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('token', res.access_token);",
                  "  console.log('Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"director@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Trial Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/trial", "host": ["{{baseUrl}}"], "path": ["auth", "trial"] }
          }
        },
        {
          "name": "Complete Profile (post-OAuth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/complete-profile", "host": ["{{baseUrl}}"], "path": ["auth", "complete-profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orgName\": \"Acme EdTech\"\n}"
            }
          }
        },
        {
          "name": "Google OAuth — Initiate",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] },
            "auth": { "type": "noauth" },
            "description": "Opens browser-based Google OAuth flow. Use in browser, not Postman."
          }
        },
        {
          "name": "Facebook OAuth — Initiate",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/facebook", "host": ["{{baseUrl}}"], "path": ["auth", "facebook"] },
            "auth": { "type": "noauth" },
            "description": "Opens browser-based Facebook OAuth flow. Use in browser, not Postman."
          }
        },
        {
          "name": "Twitter/X OAuth — Initiate",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/twitter", "host": ["{{baseUrl}}"], "path": ["auth", "twitter"] },
            "auth": { "type": "noauth" },
            "description": "Opens browser-based Twitter OAuth flow. Use in browser, not Postman."
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/leads?page=1&limit=20&stage=NEW",
              "host": ["{{baseUrl}}"],
              "path": ["leads"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                { "key": "limit", "value": "20", "description": "Items per page" },
                { "key": "stage", "value": "NEW", "description": "Filter by stage: NEW | CONTACTED | QUALIFIED | PROPOSAL | NEGOTIATION | CLOSED_WON | CLOSED_LOST", "disabled": true },
                { "key": "source", "value": "FACEBOOK", "description": "Filter by source", "disabled": true },
                { "key": "search", "value": "", "description": "Search by name/email/phone", "disabled": true },
                { "key": "assignedToId", "value": "", "description": "Filter by assigned rep ID", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/leads", "host": ["{{baseUrl}}"], "path": ["leads"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"priya@example.com\",\n  \"phone\": \"+919876543210\",\n  \"source\": \"FACEBOOK\",\n  \"stage\": \"NEW\",\n  \"courseInterest\": \"Data Science\",\n  \"notes\": \"Called via FB ad\"\n}"
            }
          }
        },
        {
          "name": "Import Leads (Bulk)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/leads/import", "host": ["{{baseUrl}}"], "path": ["leads", "import"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leads\": [\n    {\n      \"name\": \"Arjun Mehta\",\n      \"email\": \"arjun@example.com\",\n      \"phone\": \"+919876543211\",\n      \"source\": \"CSV\"\n    },\n    {\n      \"name\": \"Sneha Patel\",\n      \"email\": \"sneha@example.com\",\n      \"phone\": \"+919876543212\",\n      \"source\": \"CSV\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Lead by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/leads/:id", "host": ["{{baseUrl}}"], "path": ["leads", ":id"], "variable": [{ "key": "id", "value": "lead-id-here" }] }
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/leads/:id", "host": ["{{baseUrl}}"], "path": ["leads", ":id"], "variable": [{ "key": "id", "value": "lead-id-here" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"CONTACTED\",\n  \"courseInterest\": \"Full Stack Development\"\n}"
            }
          }
        },
        {
          "name": "Soft Delete Lead",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/leads/:id", "host": ["{{baseUrl}}"], "path": ["leads", ":id"], "variable": [{ "key": "id", "value": "lead-id-here" }] }
          }
        },
        {
          "name": "Add Note to Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/leads/:id/notes", "host": ["{{baseUrl}}"], "path": ["leads", ":id", "notes"], "variable": [{ "key": "id", "value": "lead-id-here" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Called lead — interested in weekend batch.\"\n}"
            }
          }
        },
        {
          "name": "Reassign Lead",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/leads/:id/reassign", "host": ["{{baseUrl}}"], "path": ["leads", ":id", "reassign"], "variable": [{ "key": "id", "value": "lead-id-here" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": \"user-id-here\"\n}"
            }
          }
        },
        {
          "name": "Stage Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/leads/stats/stage", "host": ["{{baseUrl}}"], "path": ["leads", "stats", "stage"] }
          }
        },
        {
          "name": "Source Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/leads/stats/source", "host": ["{{baseUrl}}"], "path": ["leads", "stats", "source"] }
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Bulk Assign Leads",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/assignments/bulk", "host": ["{{baseUrl}}"], "path": ["assignments", "bulk"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadIds\": [\"lead-id-1\", \"lead-id-2\"],\n  \"teamId\": \"team-id-here\"\n}"
            },
            "description": "Director/Manager only."
          }
        },
