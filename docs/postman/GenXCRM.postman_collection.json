            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"lead-id-here\",\n  \"teamId\": \"team-id-here\"\n}"
            },
            "description": "Director/Manager only. Uses round-robin within the team."
          }
        }
      ]
    },
