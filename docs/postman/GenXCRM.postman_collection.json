          }
        },
        {
          "name": "Communication Stats Overview",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/communications/stats/overview", "host": ["{{baseUrl}}"], "path": ["communications", "stats", "overview"] }
          }
        }
      ]
    },
