    {
      "name": "Integrations",
      "item": [
        {
          "name": "Config",
          "item": [
            {
              "name": "Get Integration Statuses",
              "request": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/integrations/config", "host": ["{{baseUrl}}"], "path": ["integrations", "config"] },
                "description": "Director/Manager only."
              }
            },
            {
              "name": "Init Facebook OAuth",
              "request": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/integrations/config/facebook/oauth/init", "host": ["{{baseUrl}}"], "path": ["integrations", "config", "facebook", "oauth", "init"] },
                "description": "Director/Manager only. Returns redirect URL."
              }
            },
            {
              "name": "Facebook OAuth Callback",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/integrations/config/facebook/oauth/callback?code=fb-auth-code&state=state-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["integrations", "config", "facebook", "oauth", "callback"],
                  "query": [
                    { "key": "code", "value": "fb-auth-code" },
                    { "key": "state", "value": "state-token" }
                  ]
                },
                "auth": { "type": "noauth" },
                "description": "Called by Facebook after OAuth. No JWT needed."
              }
            },
            {
              "name": "Init Google OAuth",
              "request": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/integrations/config/google/oauth/init", "host": ["{{baseUrl}}"], "path": ["integrations", "config", "google", "oauth", "init"] },
                "description": "Director/Manager only."
              }
            },
            {
              "name": "Google OAuth Callback",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/integrations/config/google/oauth/callback?code=google-auth-code&state=state-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["integrations", "config", "google", "oauth", "callback"],
                  "query": [
                    { "key": "code", "value": "google-auth-code" },
                    { "key": "state", "value": "state-token" }
                  ]
                },
                "auth": { "type": "noauth" },
                "description": "Called by Google after OAuth. No JWT needed."
              }
            },
            {
              "name": "Disconnect Provider",
              "request": {
                "method": "DELETE",
                "url": { "raw": "{{baseUrl}}/integrations/config/:provider", "host": ["{{baseUrl}}"], "path": ["integrations", "config", ":provider"], "variable": [{ "key": "provider", "value": "facebook" }] },
                "description": "Director/Manager only. provider = facebook | google"
              }
            },
            {
              "name": "Get Webhook Info",
              "request": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/integrations/config/webhook/info", "host": ["{{baseUrl}}"], "path": ["integrations", "config", "webhook", "info"] },
                "description": "Director/Manager only."
              }
            },
            {
              "name": "Regenerate Webhook Secret",
              "request": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/integrations/config/webhook/regenerate-secret", "host": ["{{baseUrl}}"], "path": ["integrations", "config", "webhook", "regenerate-secret"] },
                "description": "Director/Manager only."
              }
            }
          ]
        },
        {
          "name": "Facebook",
          "item": [
            {
              "name": "Webhook Verify (Hub Challenge)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/integrations/facebook/webhook?hub.mode=subscribe&hub.verify_token=genxcrm-fb-verify&hub.challenge=CHALLENGE_CODE",
                  "host": ["{{baseUrl}}"],
                  "path": ["integrations", "facebook", "webhook"],
                  "query": [
                    { "key": "hub.mode", "value": "subscribe" },
                    { "key": "hub.verify_token", "value": "genxcrm-fb-verify" },
                    { "key": "hub.challenge", "value": "CHALLENGE_CODE" }
                  ]
                },
                "auth": { "type": "noauth" }
              }
            },
            {
              "name": "Webhook Event (Lead Generated)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-hub-signature-256", "value": "sha256=hmac-signature-here" }
                ],
                "url": { "raw": "{{baseUrl}}/integrations/facebook/webhook", "host": ["{{baseUrl}}"], "path": ["integrations", "facebook", "webhook"] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"object\": \"page\",\n  \"entry\": [\n    {\n      \"id\": \"page-id\",\n      \"changes\": [\n        {\n          \"field\": \"leadgen\",\n          \"value\": {\n            \"leadgen_id\": \"123456789\",\n            \"page_id\": \"page-id\",\n            \"form_id\": \"form-id\"\n          }\n        }\n      ]\n    }\n  ]\n}"
                },
                "auth": { "type": "noauth" }
              }
            }
          ]
        },
